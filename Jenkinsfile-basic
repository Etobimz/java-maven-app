#!/usr/bin/env groovy

pipeline {
    agent none
    tools { 
        maven 'maven_3.9.10'

    }
    stages {
        stage('build jar') {
            steps {
                script {
                    echo "Building the application..."
                    sh 'mvn package'
                }
            }
        }
        stage('build image') {
            steps {
                script {
                    echo "building the docker image..."
                    withCredentials([usernamePassword(credentialsId:'docker-gub-maven-rep', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD' )])
                    sh 'docker build -t java-maven-app:2.0 . '
                    sh "echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin"
                    sh 'docker push java-maven-app:2.0'
                }
            
            }
        }
        stage('deploy') {
            steps {
                script { 
                    echo "Deploying the application..."
                }
            }
        }
    }
}
 