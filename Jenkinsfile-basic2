#!/usr/bin/env groovy

def gv 

pipeline {
    agent any
    tools { 
        maven 'maven_3.9.10'

    }

    stages {


        stage("Init") {
            steps {
                script {
                    gv = load "script.groovy"
                    
                }
            }
        }



        stage('build jar') {
            steps {
                script {
                    gv.buildJar()
                    
                }
            }
        }



        stage('build image') {
            steps {
                script {
                    gv.buildImage()
                }
            
            }
        }


        stage('deploy') {
            steps {
                script { 
                   gv.deployApp()
                }
            }
        }
    }
}
 
