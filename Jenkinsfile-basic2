pipeline {
    agent any

    tools {
        maven 'Maven 3.9.6' // This must match the name you gave in step 3
    }

    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials')
        IMAGE_NAME = 'etobimz/java-test-maven'
        VERSION = '2.0'
    }

    stages {
        stage('Test Credentials') {
            steps {
                echo "Docker username is: ${DOCKER_HUB_CREDENTIALS_USR}"
            }
        }

        stage('Build JAR') {
            steps {
                echo 'Building the JAR...'
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker Image...'
                sh "docker build -t $IMAGE_NAME:${VERSION} ."
            }
        }

        stage('Push Docker Image') {
            steps {
                echo 'Pushing Docker Image to Docker Hub...'
                sh """
                    echo $DOCKER_HUB_CREDENTIALS_PSW | docker login -u $DOCKER_HUB_CREDENTIALS_USR --password-stdin
                    docker push $IMAGE_NAME:${VERSION}
                """
            }
        }

       stage('Deploy') {
    when { 
        expression { BRANCH_NAME == 'jenkins-jobs' }
    }
    steps {
        script {
            def remoteHost = 'bimjenk@13.58.16.113'
    def dockerComposeCmd = "docker pull etobimz/java-test-maven:2.0 && docker-compose up -d"

    sshagent(['bim-ec2-server-key']) {
        sh """
            scp docker-compose.yaml Dockerfile ${remoteHost}:/home/bimjenk
            ssh -o StrictHostKeyChecking=no ${remoteHost} '${dockerComposeCmd}'
        """
            }
        }
    }
}
    }
}
