pipeline {
    agent any

    environment {
        IMAGE_NAME = "etobimz/java-maven-app"
        VERSION = "1.0.${BUILD_NUMBER}"
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds') // Correct ID for DockerHub credentials
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'jenkins-jobs', url: 'https://github.com/Etobimz/java-maven-app.git'
            }
        }

        stage('Build Maven Project') {
            tools {
                maven 'Maven 3.9.6'
            }
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${IMAGE_NAME}:${VERSION} ."
            }
        }

        stage('Push Docker Image') {
            steps {
                sh """
                    echo "${DOCKERHUB_CREDENTIALS_PSW}" | docker login -u "${DOCKERHUB_CREDENTIALS_USR}" --password-stdin
                    docker push ${IMAGE_NAME}:${VERSION}
                """
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                sh """
                    IMAGE_NAME=${IMAGE_NAME} VERSION=${VERSION} docker compose up -d
                """
            }
        }
    }

    post {
        failure {
            echo 'Build or Deployment failed.'
        }
    }
}
