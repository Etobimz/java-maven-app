#!/usr/bin/env groovy

def gv 

pipeline {
    agent any
    tools { 
        maven 'maven_3.9.10'

    }



    stages {

           stage('increment version') {
  steps {
    script {
      echo 'Incrementing app version...'
   sh '''#!/bin/bash
  echo "Parsing current version..."

  # Parse the current version using the build-helper plugin
  mvn build-helper:parse-version

  # Get the parsed version components
  MAJOR=$(mvn help:evaluate -Dexpression=parsedVersion.majorVersion -q -DforceStdout)
  MINOR=$(mvn help:evaluate -Dexpression=parsedVersion.minorVersion -q -DforceStdout)
  INCREMENTAL=$(mvn help:evaluate -Dexpression=parsedVersion.incrementalVersion -q -DforceStdout)

  # Optionally increment part of the version (e.g. bump patch)
  NEW_VERSION="$MAJOR.$MINOR.$((INCREMENTAL + 1))"

  echo "Setting new version: $NEW_VERSION"

  # Set new version
  mvn versions:set -DnewVersion=$NEW_VERSION versions:commit
'''



      def pomText = readFile('pom.xml')
      def versionMatch = pomText =~ /<version>([\d\.]+)<\/version>/
      def version = versionMatch[0][1]
      env.IMAGE_NAME = "${version}-${env.BUILD_NUMBER}"
      echo "Image name set to: ${env.IMAGE_NAME}"

    }
  }
}



        stage('build app') {
            steps {
                script {
                    echo " cleaning app "
sh ' mvn clean package '

                    
                } 
            }
        }




        stage("Init") {
            steps {
                script {
                    gv = load "script.groovy"
                    
                } 
            }
        }



        stage('build jar') {
            when { 
                expression{
                    BRANCH_NAME == 'jenkins-jobs'
                }
            }
            steps {
                script {
                    echo "Executing pipeline for branch $BRANCH_NAME"
                    gv.buildJar()
                    
                }
            }
        }



        stage('build image') {
            steps {
                script {
                    gv.buildImage()
                }
            
            }
        }


        stage('deploy') {
            when { 
                expression{
                    BRANCH_NAME == 'jenkins-jobs'
                }
            }
            steps {
                 script { 
            def remoteHost = 'bimjenk@13.58.16.113'
