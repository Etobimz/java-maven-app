pipeline {
    agent any

tools {
        maven 'Maven 3.9.6'
    }

   environment {
        DOCKER_HUB_USER = credentials('docker-hub-user') // Jenkins credentials ID
        DOCKER_HUB_PASS = credentials('docker-hub-pass') // Jenkins credentials ID
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/your/repo.git'
            }
        }

        stage('Start Services') {
            steps {
                sh 'docker-compose up -d'
            }
        }

        stage('Build with Maven') {
            steps {
                sh 'docker-compose exec -T java-maven-app mvn clean package'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                    docker build -t ${DOCKER_HUB_USER}/java-test-maven:latest .
                """
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh """
                    echo ${DOCKER_HUB_PASS} | docker login -u ${DOCKER_HUB_USER} --password-stdin
                    docker push ${DOCKER_HUB_USER}/java-test-maven:latest
                """
            }
        }
    }

    post {
        always {
            sh 'docker-compose down'
        }
    }
}
