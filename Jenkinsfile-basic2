pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy') {
            when {
                expression {
                    BRANCH_NAME == 'jenkins-jobs'
                }
            }
            steps {
                script {
                    def deployCmd = 'docker run -d -p 8080:8080 etobimz/java-test-maven:2.0'
                    sshagent(['bim-ec2-server-key']) {
                        sh "ssh -o StrictHostKeyChecking=no bimjenk@13.58.16.113 ${deployCmd}"
                    }
                    echo "Deployed to EC2 on branch ${BRANCH_NAME}"
                }
            }
        }
    }
}
