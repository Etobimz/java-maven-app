pipeline {
    agent any

    stages {
        stage('Build and Bump Version') {
            steps {
                script {
                    sh '''
                        echo "Parsing current version..."
                        mvn build-helper:parse-version

                        MAJOR=$(mvn help:evaluate -Dexpression=parsedVersion.majorVersion -q -DforceStdout)
                        MINOR=$(mvn help:evaluate -Dexpression=parsedVersion.minorVersion -q -DforceStdout)
                        PATCH=$(mvn help:evaluate -Dexpression=parsedVersion.incrementalVersion -q -DforceStdout)

                        NEW_PATCH=$((PATCH + 1))
                        NEW_VERSION="$MAJOR.$MINOR.$NEW_PATCH"

                        echo "Bumping version to: $NEW_VERSION"

                        mvn versions:set \
                            -DnewVersion=$NEW_VERSION \
                            -DgenerateBackupPoms=false \
                            -DremoveSnapshot=true \
                            -DprocessAllModules=true \
                            versions:commit

                        echo "Done. Final version is now: $(mvn help:evaluate -Dexpression=project.version -q -DforceStdout)"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
    }
}
