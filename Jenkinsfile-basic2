pipeline {
    agent any

    environment {
        IMAGE_NAME = "your-dockerhub-username/java-maven-app"
        VERSION = "1.0.${BUILD_NUMBER}"
        DOCKERHUB_CREDENTIALS = credentials('github-pat22') // Add in Jenkins > Manage Credentials
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/your-username/your-repo.git'
            }
        }

        stage('Build Maven Project') {
            tools {
                maven 'Maven 3.9.6' // Must match the Maven name in Jenkins Global Tool Config
            }
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${IMAGE_NAME}:${VERSION} ."
            }
        }

        stage('Push Docker Image') {
            steps {
                sh """
                    echo "${DOCKERHUB_CREDENTIALS_PSW}" | docker login -u "${DOCKERHUB_CREDENTIALS_USR}" --password-stdin
                    docker push ${IMAGE_NAME}:${VERSION}
                """
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                sh """
                    IMAGE_NAME=${IMAGE_NAME} VERSION=${VERSION} docker compose up -d
                """
            }
        }
    }
}
